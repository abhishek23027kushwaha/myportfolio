# ===================================================
# Server Configuration
# ===================================================
PORT=5001
NODE_ENV=development

# ===================================================
# MongoDB Database Connection
# ===================================================
# MongoDB Atlas URI or Local MongoDB URI:
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio?retryWrites=true&w=majority
# or local: mongodb://127.0.0.1:27017/portfolio
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# ===================================================
# Authentication (Admin Login & JWT)
# ===================================================
JWT_SECRET=your_jwt_secret_key_here
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# ===================================================
# Email Notification System (Nodemailer / Gmail)
# ===================================================
# Your Gmail account address used to send notifications
EMAIL_USER=your_email@gmail.com
# 16-character App Password generated from Google Account (Security -> 2-Step Verification -> App passwords)
EMAIL_PASS=your_gmail_app_password
# Inbox where contact form notifications will be received
RECEIVER_EMAIL=your_inbox_email@gmail.com
